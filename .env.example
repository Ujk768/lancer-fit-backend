# Server
PORT=8000
NODE_ENV=development

# Comma-separated CORS allowlist. Every origin that will call this API must
# appear here or requests fail before reaching a route. Include the admin
# console (5173), the Expo dev server (8081 / 19006), and the LAN address
# your phone reaches this machine on — localhost on a phone is the phone.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lancer-fit-db
DB_USER=
DB_PASSWORD=

# Tokens
# Two independent signing keys. Never reuse one for both — a leaked access
# secret must not also mint refresh tokens. Use long random strings in any
# deployed environment.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Bootstrap admin
# Created idempotently by runSeed() on first boot. This is the only account
# that exists on a fresh database; sign in to the console with it and create
# real staff accounts from there.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Mail: production
# Real sending account for verification codes and password resets.
# Leave blank in development so nothing can reach a real inbox.
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587

# Mail: development
# Mailtrap (or any catcher) inbox. Verification and reset codes are stored
# only as hashes, so a code cannot be recovered from the database — read it
# from this inbox instead.
SANDBOX_EMAIL_USER=
SANDBOX_EMAIL_PASSWORD=
SANDBOX_EMAIL_HOST=sandbox.smtp.mailtrap.io
SANDBOX_EMAIL_PORT=2525